{
  "name": "dsh-persona-dafeiyu",
  "version": "0.3.0",
  "description": "人设插件 for DeepSeek Harness：内置大肥鱼与阿茶，支持导入自定义人设（文件或粘贴）、在设置页里切换 / 启停 / 重命名 / 删除，切换后下一个请求即时生效、无需重启。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/verify.mjs",
    "privacy-check": "node scripts/privacy-check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huaizhuanghub/dsh-persona-dafeiyu.git"
  },
  "homepage": "https://github.com/huaizhuanghub/dsh-persona-dafeiyu#readme",
  "bugs": {
    "url": "https://github.com/huaizhuanghub/dsh-persona-dafeiyu/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "persona",
    "system-prompt",
    "大肥鱼",
    "阿茶"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
